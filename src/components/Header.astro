---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="sticky top-0 z-50 bg-white border-b border-neutral-200">
  <nav class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-base font-semibold tracking-tight text-neutral-950">
      YOUR_NAME
    </a>

    <div class="flex items-center gap-4 text-sm">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'transition-colors',
              isActive(link.href)
                ? 'text-neutral-950 font-medium'
                : 'text-neutral-600 hover:text-neutral-950',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>