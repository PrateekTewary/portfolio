---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/cooking', label: 'Cooking' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<!-- Phones: brand above the links and the header scrolls away. From 640px: one row, sticky. -->
<header class="z-50 border-b border-neutral-200 bg-white sm:sticky sm:top-0">
  <nav class="mx-auto flex max-w-7xl flex-col px-4 py-1 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <a href="/" class="inline-flex min-h-11 items-center font-[family-name:var(--font-fraunces)] text-lg font-semibold tracking-tight text-neutral-950">
      YOUR_NAME
    </a>

    <div class="-mx-2 flex items-center justify-between text-sm sm:mx-0 sm:-mr-2 sm:justify-end">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'inline-flex min-h-11 items-center px-2 transition-colors',
              isActive(link.href)
                ? 'text-neutral-950 font-medium'
                : 'text-neutral-600 hover:text-neutral-950',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>