---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  tags?: string[];
}

const {
  title,
  description,
  date,
  slug,
  tags = [],
} = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const href = `/blog/${slug}`;
---

<a
  href={href}
  class="block h-full rounded-lg border border-neutral-200 p-4 transition-colors hover:border-neutral-300 hover:bg-neutral-50"
>
  <article class="space-y-2">
    <time datetime={date} class="text-xs text-neutral-500">
      {formattedDate}
    </time>

    <h3 class="font-sans text-base font-semibold leading-snug tracking-tight text-neutral-900">
      {title}
    </h3>

    <p class="line-clamp-2 text-[13px] leading-5 text-neutral-700">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-0.5">
          {tags.map((tag) => (
            <span class="rounded-full border border-neutral-200 px-2 py-0.5 text-xs text-neutral-600">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </article>
</a>