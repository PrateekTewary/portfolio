---
const linkClass = 'inline-flex min-h-11 items-center px-2 transition-colors hover:text-neutral-950';
---

<footer class="border-t border-neutral-200 text-neutral-500">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-1 px-4 py-5 text-sm sm:px-6">
    <p class="py-2">© YOUR_NAME</p>

    <div class="flex flex-wrap items-center justify-center">
      <a href="mailto:YOUR_EMAIL" class={linkClass}>
        Email
      </a>

      <a
        href="YOUR_LINKEDIN"
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}
      >
        LinkedIn
      </a>

      <a
        href="https://github.com/YOU_GITHUB_USERNAME"
        target="_blank"
        rel="noopener noreferrer"
        class={linkClass}
      >
        GitHub
      </a>
    </div>
  </div>
</footer>