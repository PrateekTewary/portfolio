---
import '../styles/global.css';

import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  publishedDate?: string;
  tags?: string[];
}

const {
  title,
  description,
  ogImage,
  ogType,
  publishedDate,
  tags,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedDate={publishedDate}
      tags={tags}
    />

    <link rel="alternate" type="application/rss+xml" title="YOUR_NAME's Blog" href="/rss.xml" />
    
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-white text-neutral-900 flex flex-col">
    <Header />

    <main class="flex-1 max-w-3xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <Footer />
  </body>
</html>