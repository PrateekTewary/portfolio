---
import { getCollection, type CollectionEntry } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';

type BlogPost = CollectionEntry<'blog'>;

const posts: BlogPost[] = await getCollection('blog');

const recentPosts = posts
  .sort(
    (a: BlogPost, b: BlogPost) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .slice(0, 3);
---

<BaseLayout
  title="YOUR_NAME - Software Engineer"
  description="Personal website of YOUR_NAME, a software engineer writing about technology, software development, and lessons from building real-world products."
  ogType="website"
>
  <section class="py-16 sm:py-24">
    <div class="space-y-6">
      <h1 class="text-4xl font-bold tracking-tight text-neutral-950 sm:text-5xl">
        Hi, I'm YOUR_NAME
      </h1>

      <p class="max-w-2xl text-lg leading-8 text-neutral-700">
        I’m a software engineer who enjoys building reliable, thoughtful, and scalable products.
        This site is where I share what I’m learning, projects I’m working on, and practical notes
        from my journey in software engineering.
      </p>

      <div class="flex flex-wrap gap-3 pt-2">
        <a
          href="/blog"
          class="inline-flex items-center justify-center rounded-md bg-neutral-950 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-800"
        >
          Read my blog
        </a>

        <a
          href="/about"
          class="inline-flex items-center justify-center rounded-md border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-100"
        >
          About me
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-neutral-200 py-12">
    <h2 class="text-2xl font-semibold tracking-tight text-neutral-950">
      Recent Posts
    </h2>

    <div class="mt-8 space-y-6">
      {
        recentPosts.map((post: BlogPost) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.id}
            tags={post.data.tags}
          />
        ))
      }
    </div>

    <div class="mt-8">
      <a
        href="/blog"
        class="text-sm font-medium text-neutral-700 transition-colors hover:text-neutral-950"
      >
        View all posts →
      </a>
    </div>
  </section>
</BaseLayout>